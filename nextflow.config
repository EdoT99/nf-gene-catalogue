manifest {
    name            = 'EdoT99/nf-gene-catalogue'
    version         = '1.0.0'
    description     = 'Non-redundant gene catalogue of target enzymes from metagenomes (HMMER + MMseqs2 + CoverM)'
    nextflowVersion = '!>=26.04.0'
    license         = 'MIT'
}

outputDir = 'results'

// ---- per-process resources (selectors must match PROCESS names, not subworkflows) ----
process {
    withName: 'FASTP' {
        cpus   = 9
        memory = 30.GB
        time   = 1.d
    }
    withName: 'MEGAHIT|METASPADES' {
        cpus   = 24
        memory = 100.GB
    }
    withName: 'DEREPLICATION' {
        cpus     = 9
        memory   = 20.GB
        ext.args = '--min-seq-id 0.9 -c 0.8 --cov-mode 1'
    }
    withName: 'BOWTIE2_BUILD' {
        cpus   = 8
        memory = 16.GB
        time   = 2.h
    }
}

profiles {

    // ---- WHERE: machine / scheduler ----
    univ_hpc {
        process.executor       = 'slurm'
        process.queue          = 'parallel'                       // partition for every task job
        process.cpus           = 2                                // 'parallel' QOS requires >= 2 CPUs
        process.beforeScript   = 'ulimit -u $(ulimit -Hu)'        // default soft limit is 100 threads per user
        process.resourceLimits = [ memory: 180.GB, cpus: 36, time: 4.d ]
        process {
            // modules that ask for 1 CPU themselves: raise to the QOS minimum
            withName: 'ORF_PREDICTION|POOL_HITS|POOL_GENES' { cpus = 2 }
        }
    }
    mars {
        process.executor       = 'local'
        process.resourceLimits = [ memory: 40.GB, cpus: 16, time: 1.d ]
    }
    my_laptop {
        process.executor       = 'local'
        process.resourceLimits = [ memory: 8.GB, cpus: 4, time: 1.d ]
    }

    // ---- HOW: software environment (pick ONE) ----
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // cache folder: set NXF_SINGULARITY_CACHEDIR in your environment (see README)
    }
    conda {
        conda.enabled = true
        // env folder: set NXF_CONDA_CACHEDIR in your environment (see README)
    }
}
